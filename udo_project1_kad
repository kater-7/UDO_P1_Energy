def H(X):
    """
    Heaviside function of the matrix X
    """
    H = (X > 0).astype(int)
    return H

def build_L(A, v):
    '''
    Given input A matrix, and v vector of power lines,
    return L matrix noting all transmision lines that result in a cost decay by the H function
    '''
    D = np.diag(-v)
    L = A @ D
    print(L)
    return L

def power_grid_analysis(v, C):
    """
    Your own comments describing how this analysis function
    relates the design objective, f, and the design constraints, g, to
    the design variables, v, and constants, C.

    Parameters
    ----------
    v : array-like (n,)
       descriptions of all power lines defined by direction of energy betweeen nodes
       ex: power that moves from node 4 to node 6 is P_4_6

    C : any
        constants related to the power generation cost (applies to nodes A and B)

    Returns
    -------
    f : float
        is the output of the optimization, refers to the cost of power genteration of the entire grid
    g : array-like (m,)
        refers to cosntraint equations used in the optimization of the power grid
        4 constraints are used in this assignment:
            1. the total power generated at a generating station can not exceed the power generating
            capacity of that station.
            2. The total power delivered to a demand node must not be less than the power demanded
            at that node
            3. The power transmitted along a line must be within the power carrying capacity of the
            line.
            4. No branch connected to a generating station may transmit power into the station.

    """

    P_A_1 = v[0]    # description of design variable "P_A_1", units
    P_A_2 = v[1]    # description of design variable "P_()_()", units
    P_A_3 = v[2]
    P_B_7 = v[3]  
    P_B_8 = v[4]
    P_B_9 = v[5]
    P_1_2 = v[6]
    P_1_11 = v[7]
    P_1_12 = v[8]
    P_2_3 = v[9]
    P_2_12 = v[10]
    P_3_4 = v[11]
    P_4_5 = v[12]
    P_4_6 = v[13]
    P_5_6 = v[14]
    P_5_7 = v[15]
    P_6_7 = v[16]
    P_6_8 = v[17]
    P_7_8 = v[18]
    P_8_9 = v[19]
    P_9_10 = v[20]
    P_10_11 = v[21]
    P_10_12 = v[22]
    P_11_12 = v[23]  # description of design variable "P_11_12", units

    A = C.A         # A matrix holding the constants related to power in the grid
    b = C.b         # b vector holding the demanded energy
    c = C.c         # c vector cost  associated with the energy production
    loss = C.loss   # energy losses
    #ee = C.ee # description of constant ee, units

    #compute L from A and v in one line using @ and np.diag
    L = build_L(A,v)

    # the design objective, cTv
    # compute f from c and v in one line using @
    f = c.transpose()@v

    # the design constraints
    """
    1. the total power generated at a generating station can not exceed the power generating capacity of that station.
    2. The total power delivered to a demand node must not be less than the power demanded at that node
    3. The power transmitted along a line must be within the power carrying capacity of the line.
    4. No branch connected to a generating station may transmit power into the station.
    """
    #compute g from A, loss, H(-L), v and b in one line using *, -, and @
    v_loss = (1 - loss * H(L)) * v # V adjusted for losses
    g = ( A @ v_loss ) - b # inequality reworked in g form

    return f, g

