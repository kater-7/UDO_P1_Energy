def H(X):
    """
    Heaviside function of the matrix X
    """
    HX = 0
    if (X>0): HX = 1
    else: HX = 0
    return HX

def build_L(A, v):
    '''
    Given input A matrix, and v vector of power lines,
    return L matrix noting all transmision lines that result in a cost decay by the H function
    '''
    L = np.zeros_like(A, dtype=float)

    for i in range(A.shape[0]):
        for j in range(A.shape[1]):
            if A[i, j] == 1:
                L[i, j] = -v[j]
            elif A[i, j] == -1:
                L[i, j] = v[j]

    return L

